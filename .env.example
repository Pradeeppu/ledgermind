# Hindsight (required for real memory). Cloud: create an API key at https://ui.hindsight.vectorize.io
# Self-hosted: docker run ... then HINDSIGHT_URL=http://localhost:8888 (no key)
HINDSIGHT_URL=
HINDSIGHT_API_KEY=
LEDGERMIND_BANK_ID=ap-ledgermind-acme

# Business thresholds
AUTO_APPROVE_CONFIDENCE=0.85
PRICE_CREEP_BAND_PCT=3.0
HIGH_VALUE_LIMIT=500000
COLD_START_MIN_INVOICES=3

# UI: force the mock service (no engine) for design work
# LEDGERMIND_MOCK=1
